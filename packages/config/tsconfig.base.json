{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@repo/ui": ["../ui/src"],
      "@repo/ui/*": ["../ui/src/*"],
      "@repo/domain": ["../domain/src"],
      "@repo/domain/*": ["../domain/src/*"],
      "@repo/api-client": ["../api-client/src"],
      "@repo/api-client/*": ["../api-client/src/*"],
      "@repo/auth": ["../auth/src"],
      "@repo/auth/*": ["../auth/src/*"]
    }
  }
}
